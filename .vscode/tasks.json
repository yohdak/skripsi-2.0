{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Sempro (mainsempro.tex)",
      "type": "shell",
      "command": "latexmk -xelatex -synctex=1 -interaction=nonstopmode mainsempro.tex",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$latex"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    {
      "label": "Compile Skripsi Lengkap (main.tex)",
      "type": "shell",
      "command": "latexmk -xelatex -synctex=1 -interaction=nonstopmode main.tex",
      "group": "build",
      "problemMatcher": ["$latex"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    {
      "label": "Clean Auxiliary Files",
      "type": "shell",
      "command": "latexmk -c",
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
